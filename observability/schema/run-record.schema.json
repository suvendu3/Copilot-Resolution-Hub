{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://copilot-resolution-hub/observability/run-record.schema.json",
  "title": "Agent Run Record",
  "description": "One defect/work-item run captured as a distributed trace. Root becomes the trace; each span entry becomes an OpenTelemetry span.",
  "type": "object",
  "required": ["run_id", "spans"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique run identifier. Prefer the ADO work item ref, e.g. AB#877491."
    },
    "work_item_id": {
      "type": "string",
      "description": "ADO work item id, if applicable."
    },
    "system": {
      "type": "string",
      "enum": ["CRM", "CCaaS", "API", "Unknown"],
      "description": "Routed target system."
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "attributes": {
      "type": "object",
      "description": "Root-span attributes (low-cardinality, no secrets/PII).",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/span" }
    }
  },
  "definitions": {
    "span": {
      "type": "object",
      "required": ["name", "started_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Dotted span name, e.g. supervisor.enrich, route.decision, maker.propose, checker.verdict." },
        "agent": { "type": "string", "description": "Emitting agent name (matches .github/agents/*)." },
        "stage": {
          "type": "string",
          "enum": ["input", "route", "evidence", "propose", "check", "output", "approval"]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["ok", "blocked", "error"], "default": "ok" },
        "attributes": {
          "type": "object",
          "description": "Scalar span attributes only. No secrets, PATs, or PII.",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "attributes": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean"] }
              }
            }
          }
        },
        "children": {
          "type": "array",
          "description": "Optional nested spans for MCP calls or sub-agent hops.",
          "items": { "$ref": "#/definitions/span" }
        }
      }
    }
  }
}
